# Copy to `frontend/.env.local` for local overrides (do not commit secrets).
# On Vercel: set VITE_API_BASE_URL in Project → Settings → Environment Variables.

# Backend API base URL including /api/v1 (matches FastAPI router prefix).
# You may also set only the origin (e.g. https://your-api.onrender.com); the client appends /api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1
